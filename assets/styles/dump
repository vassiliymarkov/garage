
/*** HERO ***/
.hero {
    position: relative;
    width: 100%;
    height: 100vh;
    font-family: 'Inter';
    background-image: url("../img/content/main-hero.webp");
    background-size: cover;
    background-position: center;
}

.hero__overlay {
    width: 100%;
    height: 100%;
    background: #000000;
    opacity: 0.5;
    z-index: 3;
    position: absolute;
    inset: 0;
}

.hero__content {
    z-index: 3;
    color: #ffffff;
    font-size: 50px;
    position: absolute;
    top: 15%;
    padding: 0 30px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
}

.hero__text {
    width: 100%;

}

/* .hero__title {
    font-size: 22px;
    
    font-weight: 600;
} */

.hero__items {
    margin-top: 20px;
    padding-left: 20px;
}

.hero__items img {
    margin-right: 15px;
    width: 20px;
    height: 20px;
}

.hero__item {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    font-size: 18px;
    margin-bottom: 10px;
}

.hero__form {
    background-color: #477524;
    opacity: 0.7;
    width: 100%;
    max-width: 700px;
    padding: 10px;
    margin-top: 10px;
}

.hero__inputs-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
}

.hero__row {
    display: flex;
    gap: 16px;
    width: 100%;
}

.visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
}

.hero__row .hero__input {
    flex: 1;
}

.hero__input {
    box-sizing: border-box;
    width: 100%;
    height: 23px;
    font-family: 'Inter';
    font-size: 14px;
    font-weight: 600;
}

.hero__btn {
    background-color: #448016;
    width: 100%;
    height: 38px;
    border: 3px solid #ffffff;
    border-radius: 8px;
    font-family: 'Inter';
    font-size: 16px;
    font-weight: 600;
    color: #ffffff;
}

.hero__btn:hover {
    background-color: #90cf60;
    color: #0C243F;
}

#find {
    margin-top: 25px;
}

.or {
    font-family: 'Inter';
    font-size: 16px;
    font-weight: 600;
    color: #ffffff;
}

@media(min-width: 481px) {
    /* .hero__title {
        font-size: 24px;
    } */

    .hero__items {
        margin: 20px 0 30px 0;
    }

    .hero__item {
        font-size: 22px;
    }

    .hero__form {
        padding: 20px;
    }

    .hero__input {
        font-size: 16px;
    }

    .hero__btn {
        font-size: 18px;
        height: 30px;
    }

    .or {
        font-size: 16px;

    }
}

@media(min-width: 641px) {
    .hero__items {
        display: flex;
        justify-content: flex-start;
        align-items: center;
        flex-wrap: wrap;
        flex-basis: 50%;
        column-gap: 30px;
        margin: 10px 0 0 0;
    }

    .hero__item {
        font-size: 20px;
    }

    .hero__form {
        padding: 20px;
    }

    .hero__input {
        font-size: 14px;
    }

    .hero__btn,
    .or {
        font-size: 18px;
    }
}

@media(min-width: 767px) {
