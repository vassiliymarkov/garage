/*** CARS **/
.cars {
    max-width: 1393px;
    width: 90%;
    margin: 100px auto;
    font-family: 'Roboto';
}

.cars__card-container {
    margin: 30px auto;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
}

.cars__card {
    background-color: #ffffff;
    /*  width: 321px; */
    height: 377px;
}

.cars__img-container {
    width: 100%;
    height: 240px;
}

.cars__img-container img {
    width: 100%;
    height: 240px;
    object-fit: cover;
}

.cars__specs {
    width: 100%;
    padding: 28px 22px;
}

.cars__price {
    font-size: 18px;
    font-weight: 600;
}

.cars__brand {
    font-size: 16px;
    font-weight: 500;
}

.cars__year {
    font-size: 15px;
    font-weight: 500;
}

.cars__price,
.cars__brand {
    margin-bottom: 13px;
}